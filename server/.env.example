# ============================================
# Конфигурация сервера
# ============================================

# Порт сервера
PORT=3001

# Окружение (development, production)
NODE_ENV=production

# URL фронтенда (для CORS)
FRONTEND_URL=http://localhost:5173

# ============================================
# Конфигурация MySQL
# ============================================

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_secure_password_here
DB_NAME=project_office_db

# ============================================
# JWT конфигурация
# ============================================

# Секретный ключ для JWT (ОБЯЗАТЕЛЬНО измените в продакшене!)
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-this-to-a-very-long-random-string-in-production-min-256-bits

# Время жизни токена
JWT_EXPIRES_IN=24h

# ============================================
# Безопасность
# ============================================

# Максимальное количество попыток входа до блокировки
MAX_LOGIN_ATTEMPTS=5

# Длительность блокировки аккаунта (в секундах)
LOCKOUT_DURATION=900

# Таймаут сессии (в секундах, по умолчанию 24 часа)
SESSION_TIMEOUT=86400

# Минимальная длина пароля
PASSWORD_MIN_LENGTH=8

# ============================================
# Логирование
# ============================================

# Уровень логирования (error, warn, info, debug)
LOG_LEVEL=info

# Путь для файлов логов (опционально)
LOG_PATH=./logs
